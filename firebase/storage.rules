rules_version = '2';

// Ak Emlak — başvuru fotoğrafları
// Ziyaretçi yalnızca kendi klasörüne, küçültülmüş resim yükleyebilir; okuyamaz, silemez, değiştiremez.
// Başvuru fotoğraflarını yalnızca yetkililer (yönetim uygulaması) okur. Yetkililer ilan fotoğraflarını
// kendi yonetim/{uid}/ klasörlerine yükler; sunucu fonksiyonu bunları siteye ekler.
service firebase.storage {
  match /b/{bucket}/o {
    // Firestore kurallarındaki yetkili() ile aynı koşul
    function yetkili() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/yetkililer/$(request.auth.token.email));
    }

    match /basvurular/{uid}/{file} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]{16,40}[.](webp|jpg)$')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
      allow read: if yetkili();
      allow update, delete: if false;
    }
    match /yonetim/{uid}/{file} {
      allow create: if yetkili()
        && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]{16,40}[.](webp|jpg)$')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
      allow read, delete: if yetkili() && request.auth.uid == uid;
      allow update: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
