rules_version = '2';

// Ak Emlak — ilan başvuruları
// Ziyaretçi (anonim oturum) yalnızca kendi adına YENİ başvuru oluşturabilir; başvuruları okuyamaz,
// değiştiremez, silemez. Başvuruları yalnızca yetkililer (yönetim uygulaması) okur ve durumlarını günceller.
// Yetkili: Google ile giriş yapmış, e-postası doğrulanmış ve `yetkililer/{eposta}` kaydı olan kullanıcı.
// Yetkili listesi yalnızca Firebase konsolundan değiştirilebilir.
service cloud.firestore {
  match /databases/{database}/documents {

    function yetkili() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/yetkililer/$(request.auth.token.email));
    }

    // Yetkilinin başvuruda değiştirebildiği tek şey: durum ve kendi adıyla inceleme bilgisi
    function validInceleme() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'inceleme'])
        && d.status in ['yeni', 'inceleniyor', 'onaylandi', 'reddedildi']
        && d.inceleme is map
        && d.inceleme.keys().hasAll(['guncelleyen', 'guncellendi'])
        && d.inceleme.keys().hasOnly(['guncelleyen', 'guncellendi', 'ilanNo', 'redSebebi'])
        && d.inceleme.guncelleyen == request.auth.token.email
        && d.inceleme.guncellendi == request.time
        && (!('redSebebi' in d.inceleme) || str(d.inceleme.redSebebi, 0, 300))
        && (!('ilanNo' in d.inceleme) || str(d.inceleme.ilanNo, 1, 20));
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function optStr(m, k, max) {
      return !(k in m) || str(m[k], 1, max);
    }
    function optNum(m, k, max) {
      return !(k in m) || ((m[k] is int || m[k] is float) && m[k] >= 0 && m[k] <= max);
    }
    function optEnum(m, k, values) {
      return !(k in m) || m[k] in values;
    }
    function appNumber(v) {
      return v is string && v.matches('^B-[A-Z0-9]{6}$');
    }

    function validSeller(s) {
      return s is map
        && s.keys().hasAll(['name', 'phone'])
        && s.keys().hasOnly(['name', 'phone', 'email'])
        && str(s.name, 3, 80)
        // Türkiye cep telefonu: +905XXXXXXXXX
        && s.phone is string && s.phone.matches('^[+]905[0-9]{9}$')
        && (!('email' in s) || (str(s.email, 6, 120) && s.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')));
    }

    function validListing(l) {
      return l is map
        && l.keys().hasAll(['type'])
        && l.keys().hasOnly([
          'type', 'deal', 'city', 'district', 'neighborhood', 'address', 'price',
          'grossM2', 'netM2', 'rooms', 'floor', 'buildingAge', 'bathrooms', 'heating',
          'furnished', 'inSite', 'zoning', 'deed', 'parcel',
          'brand', 'model', 'modelYear', 'km', 'fuel', 'gear',
          'description', 'features'
        ])
        && l.type in ['daire', 'mustakil', 'villa', 'arsa', 'tarla', 'isyeri', 'arac', 'diger']
        && optEnum(l, 'deal', ['satilik', 'kiralik'])
        && optStr(l, 'city', 60) && optStr(l, 'district', 60) && optStr(l, 'neighborhood', 80)
        && optStr(l, 'address', 300)
        && optNum(l, 'price', 100000000000)
        // Ayrıntı alanlarının (m², oda, kat, araç bilgileri…) tür/uzunluk kontrolü, kural ifade sınırını (1000)
        // aşmamak için sunucu fonksiyonunda yapılır; hatalı alan işaretlenir ve kısaltılır.
        && optStr(l, 'description', 3000)
        && (!('features' in l) || (l.features is list && l.features.size() <= 20));
    }

    function validResubmission(r) {
      return r is map
        && r.keys().hasOnly(['isResubmission', 'of', 'original', 'revision'])
        && r.keys().hasAll(['isResubmission', 'of', 'original', 'revision'])
        && r.isResubmission is bool
        && r.revision is int && r.revision >= 0 && r.revision <= 100
        && (r.of == null || appNumber(r.of))
        && (r.original == null || appNumber(r.original))
        // Tekrar gönderimde önceki başvuru numarası ve sürüm zorunlu, ilk gönderimde boş
        && (r.isResubmission == (r.of != null))
        && (r.isResubmission == (r.revision > 0));
    }

    match /basvurular/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['number', 'uid', 'createdAt', 'status', 'seller', 'listing', 'photos', 'resubmission', 'consent'])
        && request.resource.data.keys().hasOnly(['number', 'uid', 'createdAt', 'status', 'seller', 'listing', 'photos', 'resubmission', 'consent'])
        && appNumber(request.resource.data.number)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'yeni'
        && validSeller(request.resource.data.seller)
        && validListing(request.resource.data.listing)
        // Fotoğraf yolları ve dosyaları sunucu fonksiyonunda ayrıca doğrulanır
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 10
        && validResubmission(request.resource.data.resubmission)
        && request.resource.data.consent is map
        && request.resource.data.consent.keys().hasOnly(['kvkk', 'version'])
        && request.resource.data.consent.kvkk == true
        && str(request.resource.data.consent.version, 1, 20)
        // Hız sınırı: başvuru, aynı yazımda güncellenen /limits/{uid} kaydıyla birlikte yapılmalı
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.lastAt == request.time;
      allow read: if yetkili();
      allow update: if yetkili() && validInceleme();
      allow delete: if false;

      // Yetkililerin birbirine görünen notları
      match /notlar/{notId} {
        allow read: if yetkili();
        allow create: if yetkili()
          && request.resource.data.keys().hasAll(['metin', 'yazan', 'tarih'])
          && request.resource.data.keys().hasOnly(['metin', 'yazan', 'tarih'])
          && str(request.resource.data.metin, 1, 1000)
          && request.resource.data.yazan == request.auth.token.email
          && request.resource.data.tarih == request.time;
        allow delete: if yetkili() && resource.data.yazan == request.auth.token.email;
        allow update: if false;
      }
    }

    // Yetkili listesi: kişi yalnızca kendi kaydını okuyabilir (uygulama yetkiyi buradan anlar)
    match /yetkililer/{email} {
      allow read: if request.auth != null
        && request.auth.token.email == email
        && request.auth.token.email_verified == true;
      allow write: if false;

      // Bildirim alınan cihazlar (FCM)
      match /cihazlar/{cihazId} {
        allow read, delete: if yetkili() && request.auth.token.email == email;
        allow create, update: if yetkili() && request.auth.token.email == email
          && request.resource.data.keys().hasAll(['token', 'eklendi', 'cihaz'])
          && request.resource.data.keys().hasOnly(['token', 'eklendi', 'cihaz'])
          && str(request.resource.data.token, 1, 4096)
          && str(request.resource.data.cihaz, 0, 80)
          && request.resource.data.eklendi == request.time;
      }
    }

    // Siteye yapılan değişikliklerin kaydı (yalnızca sunucu fonksiyonları yazar)
    match /islemler/{id} {
      allow read: if yetkili();
      allow write: if false;
    }

    // Aynı oturumdan en fazla dakikada 1 başvuru
    match /limits/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && resource.data.lastAt < request.time - duration.value(60, 's');
      allow read, delete: if false;
    }

    // Diğer her şey (örn. /ayarlar) istemcilere kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
